# Secrets
.env
.env.local
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# DBs (data, not code)
collection.db
collection.db-journal
collection.db-wal
collection.db-shm
enrichment.db
enrichment.db-journal
enrichment.db-wal
enrichment.db-shm
backup/dbs/
backup/*.zip

# Scan logs and debug outputs
logs/
scan_logs/
test_logs/
debug_crops/
debug_warps/
/debug_*.png
/debug_*.jpg
diag_*/
*.log
sim_debug.log
sim_start.log
layout_test_failures/
foil_signal1/

# Large data files (user regenerates locally)
downloaded_cards/
card_hashes*.json
card_hashes*.npz
card_embeddings.npz
default-cards-*.json
AtomicCards.json

# Set-symbol asset cache (regenerated by fetch_set_symbols.py).
# Keep the averaged-from-PNGs roi_templates/ in VCS — they're small
# (~2MB total) and needed by set_icon.py at runtime / in tests.
card_data/set_symbols/*
!card_data/set_symbols/roi_templates/
card_data/set_symbols/roi_templates/*
!card_data/set_symbols/roi_templates/*.png

# Test artifacts — keep only _pinned.json snapshots
tests/probe_snapshots/*_20*.json

# Frame-classifier fixture PNGs (regenerated by download_frame_fixtures.py).
# Keep plan.csv in VCS so the fixture set is reproducible.
tests/fixtures/frame_classifier/**/*.png

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/
*.swp
